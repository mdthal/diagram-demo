@using BlockDiagramDemo.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="block-diagram-editor @ClassName">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button class="btn btn-sm btn-danger"
                @onclick="DeleteSelectionAsync"
                disabled="@(_selectedBlockId is null && _selectedLinkId is null)">
            Delete selected
        </button>
        <button class="btn btn-sm btn-outline-secondary"
                @onclick="UndoAsync"
                disabled="@(!CanUndo)">
            Undo
        </button>
        <button class="btn btn-sm btn-outline-secondary"
                @onclick="RedoAsync"
                disabled="@(!CanRedo)">
            Redo
        </button>
        <button class="btn btn-sm btn-secondary" @onclick="ResetSampleAsync">Reset sample</button>
        <button class="btn btn-sm btn-outline-dark" @onclick="ToggleInspectorPanel">
            @(_showInspector ? "Hide inspector" : "Show inspector")
        </button>
    </div>

    <div class="row g-3">
        <div class="@CanvasColumnClass">
            <div class="diagram-canvas-shell">
                <div class="diagram-canvas"
                     @ref="_canvasElement"
                     @onmousemove="HandleCanvasMouseMoveAsync"
                     @onmouseup="HandleCanvasMouseUp"
                     @onmouseleave="HandleCanvasMouseLeave">
                    <div class="diagram-lane lane-input" style="@GetLaneStyle(DiagramBlockRole.Input)"></div>
                    <div class="diagram-lane lane-function" style="@GetLaneStyle(DiagramBlockRole.Function)"></div>
                    <div class="diagram-lane lane-output" style="@GetLaneStyle(DiagramBlockRole.Output)"></div>

                    <div class="diagram-lane-header lane-input-header" style="@GetLaneStyle(DiagramBlockRole.Input)">
                        <span class="diagram-lane-title">Inputs</span>
                        <button type="button"
                                class="btn btn-sm btn-success diagram-lane-add"
                                @onclick="AddInputBlockAsync">
                            Add
                        </button>
                    </div>
                    <div class="diagram-lane-header lane-function-header" style="@GetLaneStyle(DiagramBlockRole.Function)">
                        <span class="diagram-lane-title">Functions</span>
                        <button type="button"
                                class="btn btn-sm btn-primary diagram-lane-add"
                                @onclick="AddFunctionBlockAsync">
                            Add
                        </button>
                    </div>
                    <div class="diagram-lane-header lane-output-header" style="@GetLaneStyle(DiagramBlockRole.Output)">
                        <span class="diagram-lane-title">Outputs</span>
                        <button type="button"
                                class="btn btn-sm btn-warning diagram-lane-add"
                                @onclick="AddOutputBlockAsync">
                            Add
                        </button>
                    </div>

                    <svg class="diagram-links">
                        <defs>
                            <marker id="@_arrowHeadId"
                                    markerWidth="6"
                                    markerHeight="4"
                                    refX="6"
                                    refY="2"
                                    orient="auto"
                                    markerUnits="strokeWidth">
                                <polygon points="0 0, 6 2, 0 4" class="link-arrow-head" />
                            </marker>
                        </defs>

                        @foreach (var link in Model.Links)
                        {
                            if (!BlockDiagramRouter.TryGetLinkPath(Model, link, out var pathData))
                            {
                                continue;
                            }

                            <path d="@pathData"
                                  class="link-hit-target"
                                  @onclick="(() => HandleLinkClick(link.Id))"
                                  @onclick:stopPropagation="true"></path>

                            <path d="@pathData"
                                  class="@GetLinkCssClass(link)"
                                  marker-end="url(#@_arrowHeadId)"></path>

                        }

                        @if (TryGetConnectionPreviewPath(out var previewPath))
                        {
                            <path d="@previewPath"
                                  class="link-preview"
                                  marker-end="url(#@_arrowHeadId)"></path>
                        }
                    </svg>

                    @foreach (var block in Model.Blocks)
                    {
                        <div class="diagram-block-shell" style="@GetBlockShellStyle(block)">
                            <button type="button"
                                    class="@GetBlockCssClass(block)"
                                    @onmousedown="@(args => HandleBlockMouseDown(block, args))"
                                    @onclick="@(args => HandleBlockClickAsync(block, args))">
                                <span>@block.Label</span>
                            </button>

                            @foreach (var side in BlockDiagramConnectionRules.GetVisibleConnectorSides(block))
                            {
                                <button type="button"
                                        class="@GetConnectorCssClass(block, side)"
                                        style="@GetConnectorStyle(block, side)"
                                        title="@GetConnectorTitle(block, side)"
                                        @onmousedown="@(args => HandleConnectorMouseDown(block, side, args))"
                                        @onmouseup="@(args => HandleConnectorMouseUpAsync(block, side, args))"
                                        @onmousedown:stopPropagation="true"
                                        @onmousedown:preventDefault="true"
                                        @onmouseup:stopPropagation="true"
                                        @onmouseup:preventDefault="true"
                                        @onclick:stopPropagation="true"
                                        @onclick:preventDefault="true"></button>
                            }

                            <button type="button"
                                    class="@GetResizeHandleCssClass(block)"
                                    style="@GetResizeHandleStyle(block)"
                                    title="Resize block"
                                    @onmousedown="@(args => HandleResizeMouseDown(block, args))"
                                    @onmousedown:stopPropagation="true"
                                    @onmousedown:preventDefault="true"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true"></button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_showInspector)
        {
        <div class="col-12 col-xxl-3">
            <section class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6 mb-3">Inspector</h2>
                    @if (SelectedBlock is not null)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold mb-1">Label</label>
                            <input class="form-control"
                                   value="@SelectedBlock.Label"
                                   @oninput="HandleLabelInputAsync" />
                        </div>
                        <div class="small text-secondary">
                            <div><span class="fw-semibold text-dark">Type:</span> Block</div>
                            <div><span class="fw-semibold text-dark">Role:</span> @SelectedBlock.Role</div>
                            <div><span class="fw-semibold text-dark">Id:</span> @SelectedBlock.Id</div>
                            <div><span class="fw-semibold text-dark">Position:</span> @($"{SelectedBlock.X:0}, {SelectedBlock.Y:0}")</div>
                            <div><span class="fw-semibold text-dark">Size:</span> @($"{SelectedBlock.Width:0} x {SelectedBlock.Height:0}")</div>
                            <div><span class="fw-semibold text-dark">Outgoing:</span> @Model.Links.Count(link => link.SourceBlockId == SelectedBlock.Id)</div>
                            <div><span class="fw-semibold text-dark">Incoming:</span> @Model.Links.Count(link => link.TargetBlockId == SelectedBlock.Id)</div>
                        </div>
                    }
                    else if (SelectedLink is not null)
                    {
                        <div class="small text-secondary">
                            <div><span class="fw-semibold text-dark">Type:</span> Connection</div>
                            <div><span class="fw-semibold text-dark">Id:</span> @SelectedLink.Id</div>
                            <div><span class="fw-semibold text-dark">From:</span> @($"{SelectedLink.SourceBlockId} ({SelectedLink.SourceSide})")</div>
                            <div><span class="fw-semibold text-dark">To:</span> @($"{SelectedLink.TargetBlockId} ({SelectedLink.TargetSide})")</div>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary small mb-0">Select a block or a connection to inspect and edit.</p>
                    }
                </div>
            </section>
        </div>
        }
    </div>
    <p class="status-note mt-3 mb-0">@_status</p>
</div>

@code {
    private const double ConnectorHandleSize = 8;
    private const double ConnectorHitTargetSize = 24;
    private const double ResizeHandleSize = 8;

    [Parameter, EditorRequired]
    public BlockDiagramModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<BlockDiagramModel> ModelChanged { get; set; }

    [Parameter]
    public string ClassName { get; set; } = string.Empty;

    private readonly string _arrowHeadId = $"arrow_{Guid.NewGuid():N}";
    private readonly Stack<DiagramHistorySnapshot> _undoStack = new();
    private readonly Stack<DiagramHistorySnapshot> _redoStack = new();
    private string? _selectedBlockId;
    private string? _selectedLinkId;
    private string? _draggingBlockId;
    private string? _resizingBlockId;
    private ConnectionDragState? _connectionDrag;
    private DiagramHistorySnapshot? _dragStartSnapshot;
    private DiagramHistorySnapshot? _resizeStartSnapshot;
    private double _dragStartClientX;
    private double _dragStartClientY;
    private double _dragStartBlockX;
    private double _dragStartBlockY;
    private double _resizeStartClientX;
    private double _resizeStartClientY;
    private double _resizeStartWidth;
    private double _resizeStartHeight;
    private ElementReference _canvasElement;
    private DotNetObjectReference<BlockDiagramEditor>? _dotNetReference;
    private double _canvasWidth = BlockDiagramLayout.MinimumCanvasWidth;
    private string _status = "Ready";
    private bool _showInspector;
    private bool _hasMeasuredCanvas;

    private DiagramBlock? SelectedBlock => TryGetBlock(_selectedBlockId);

    private DiagramLink? SelectedLink => TryGetLink(_selectedLinkId);

    private string CanvasColumnClass => _showInspector ? "col-12 col-xxl-9" : "col-12";

    private bool CanUndo => _undoStack.Count > 0;

    private bool CanRedo => _redoStack.Count > 0;

    private string ConnectionHint =>
        _connectionDrag is null
            ? "Valid links: Input -> Function, Function -> Function, Function -> Output"
            : "Connecting: release on a connector point";

    protected override void OnParametersSet()
    {
        Model ??= new BlockDiagramModel();

        if (_hasMeasuredCanvas)
        {
            BlockDiagramLayout.ConstrainBlocksToLanes(Model, _canvasWidth);
        }

        if (TryGetBlock(_selectedBlockId) is null)
        {
            _selectedBlockId = null;
        }

        if (TryGetLink(_selectedLinkId) is null)
        {
            _selectedLinkId = null;
        }

        if (TryGetBlock(_draggingBlockId) is null)
        {
            _draggingBlockId = null;
        }

        if (TryGetBlock(_resizingBlockId) is null)
        {
            _resizingBlockId = null;
        }

        if (_connectionDrag is not null && TryGetBlock(_connectionDrag.SourceBlockId) is null)
        {
            _connectionDrag = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("blockDiagramInterop.observeCanvas", _canvasElement, _dotNetReference);
            await JS.InvokeVoidAsync("blockDiagramInterop.registerDeleteShortcut", _canvasElement, _dotNetReference);
        }

        await UpdateCanvasWidthAsync();
    }

    private Task AddInputBlockAsync() => AddBlockAsync(DiagramBlockRole.Input);

    private Task AddFunctionBlockAsync() => AddBlockAsync(DiagramBlockRole.Function);

    private Task AddOutputBlockAsync() => AddBlockAsync(DiagramBlockRole.Output);

    private async Task AddBlockAsync(DiagramBlockRole role)
    {
        RecordHistoryBeforeChange();

        var block = BlockDiagramLayout.CreateBlock(role, Model, _canvasWidth);
        Model.Blocks.Add(block);
        _selectedBlockId = block.Id;
        _selectedLinkId = null;
        _status = $"Added {role.ToString().ToLowerInvariant()} block \"{block.Label}\".";

        await NotifyModelChangedAsync();
    }

    private async Task DeleteSelectionAsync()
    {
        if (_selectedLinkId is not null)
        {
            if (TryGetLink(_selectedLinkId) is null)
            {
                _selectedLinkId = null;
                _status = "Selection no longer exists.";
                return;
            }

            RecordHistoryBeforeChange();

            var removedLinkCount = Model.Links.RemoveAll(link => link.Id == _selectedLinkId);
            _selectedLinkId = null;

            if (removedLinkCount > 0)
            {
                _status = "Deleted selected connection.";
                await NotifyModelChangedAsync();
            }

            return;
        }

        if (_selectedBlockId is null)
        {
            return;
        }

        if (TryGetBlock(_selectedBlockId) is null)
        {
            _selectedBlockId = null;
            _connectionDrag = null;
            _status = "Selection no longer exists.";
            return;
        }

        RecordHistoryBeforeChange();

        var removedCount = Model.Links.RemoveAll(
            link => link.SourceBlockId == _selectedBlockId || link.TargetBlockId == _selectedBlockId);

        var removedBlock = Model.Blocks.RemoveAll(block => block.Id == _selectedBlockId) > 0;
        if (!removedBlock)
        {
            _status = "Selection no longer exists.";
            _selectedBlockId = null;
            _connectionDrag = null;
            return;
        }

        _status = removedCount == 0
            ? "Deleted selected block."
            : $"Deleted selected block and {removedCount} link(s).";

        _selectedBlockId = null;
        _draggingBlockId = null;
        _resizingBlockId = null;
        _connectionDrag = null;

        await NotifyModelChangedAsync();
    }

    private async Task ResetSampleAsync()
    {
        RecordHistoryBeforeChange();

        Model = BlockDiagramSampleFactory.CreateDefault();
        _selectedBlockId = null;
        _selectedLinkId = null;
        _draggingBlockId = null;
        _resizingBlockId = null;
        _connectionDrag = null;
        _status = "Diagram reset to sample.";

        await NotifyModelChangedAsync();
    }

    private async Task UndoAsync()
    {
        if (!CanUndo)
        {
            return;
        }

        _redoStack.Push(CaptureHistorySnapshot());
        RestoreHistorySnapshot(_undoStack.Pop());
        _status = "Undid last change.";

        await NotifyModelChangedAsync();
    }

    private async Task RedoAsync()
    {
        if (!CanRedo)
        {
            return;
        }

        _undoStack.Push(CaptureHistorySnapshot());
        RestoreHistorySnapshot(_redoStack.Pop());
        _status = "Redid last change.";

        await NotifyModelChangedAsync();
    }

    [JSInvokable]
    public Task HandleDeleteShortcut()
    {
        if (_selectedBlockId is null && _selectedLinkId is null)
        {
            return Task.CompletedTask;
        }

        return DeleteSelectionAsync();
    }

    private void HandleBlockMouseDown(DiagramBlock block, MouseEventArgs args)
    {
        if (_connectionDrag is not null || _resizingBlockId is not null || args.Button != 0)
        {
            return;
        }

        _selectedBlockId = block.Id;
        _selectedLinkId = null;
        _draggingBlockId = block.Id;
        _dragStartSnapshot = CaptureHistorySnapshot();
        _dragStartClientX = args.ClientX;
        _dragStartClientY = args.ClientY;
        _dragStartBlockX = block.X;
        _dragStartBlockY = block.Y;
        _status = $"Dragging {block.Label}...";
    }

    private Task HandleBlockClickAsync(DiagramBlock block, MouseEventArgs _)
    {
        if (_connectionDrag is not null)
        {
            return Task.CompletedTask;
        }

        _selectedBlockId = block.Id;
        _selectedLinkId = null;
        _status = $"Selected {block.Label}.";
        return Task.CompletedTask;
    }

    private void HandleResizeMouseDown(DiagramBlock block, MouseEventArgs args)
    {
        if (_connectionDrag is not null || args.Button != 0)
        {
            return;
        }

        _selectedBlockId = block.Id;
        _selectedLinkId = null;
        _draggingBlockId = null;
        _resizingBlockId = block.Id;
        _resizeStartSnapshot = CaptureHistorySnapshot();
        _resizeStartClientX = args.ClientX;
        _resizeStartClientY = args.ClientY;
        _resizeStartWidth = block.Width;
        _resizeStartHeight = block.Height;
        _status = $"Resizing {block.Label}...";
    }

    private void HandleConnectorMouseDown(DiagramBlock block, DiagramConnectorSide side, MouseEventArgs args)
    {
        if (_resizingBlockId is not null || args.Button != 0)
        {
            return;
        }

        if (!BlockDiagramConnectionRules.GetVisibleConnectorSides(block).Contains(side))
        {
            return;
        }

        var startValidation = BlockDiagramConnectionRules.ValidateConnectionStart(block, side);
        if (!startValidation.IsValid)
        {
            _status = startValidation.Reason;
            return;
        }

        _selectedBlockId = block.Id;
        _selectedLinkId = null;
        _draggingBlockId = null;

        var (startX, startY) = BlockDiagramRouter.GetConnectorPoint(block, side);

        _connectionDrag = new ConnectionDragState
        {
            SourceBlockId = block.Id,
            SourceSide = side,
            StartClientX = args.ClientX,
            StartClientY = args.ClientY,
            StartX = startX,
            StartY = startY,
            CurrentX = startX,
            CurrentY = startY
        };

        _status = $"Connecting from {block.Label} ({side}).";
    }

    private async Task HandleConnectorMouseUpAsync(DiagramBlock targetBlock, DiagramConnectorSide targetSide, MouseEventArgs _)
    {
        if (_connectionDrag is null)
        {
            return;
        }

        var sourceBlock = TryGetBlock(_connectionDrag.SourceBlockId);
        if (sourceBlock is null)
        {
            CancelConnectionDrag("Source block no longer exists.");
            await InvokeAsync(StateHasChanged);
            return;
        }

        var validation = BlockDiagramConnectionRules.ValidateConnection(
            Model,
            sourceBlock,
            _connectionDrag.SourceSide,
            targetBlock,
            targetSide);
        if (!validation.IsValid)
        {
            CancelConnectionDrag(validation.Reason);
            await InvokeAsync(StateHasChanged);
            return;
        }

        var createdLink = new DiagramLink
        {
            Id = $"link_{Guid.NewGuid():N}",
            SourceBlockId = _connectionDrag.SourceBlockId,
            TargetBlockId = targetBlock.Id,
            SourceSide = _connectionDrag.SourceSide,
            TargetSide = targetSide
        };

        RecordHistoryBeforeChange();
        Model.Links.Add(createdLink);

        _connectionDrag = null;
        _selectedLinkId = createdLink.Id;
        _selectedBlockId = null;
        _status = "Connection added.";

        await NotifyModelChangedAsync();
    }

    private async Task HandleCanvasMouseMoveAsync(MouseEventArgs args)
    {
        if (_connectionDrag is not null)
        {
            if (args.Buttons == 0)
            {
                CancelConnectionDrag("Connection cancelled.");
                await InvokeAsync(StateHasChanged);
                return;
            }

            var previewRawX = _connectionDrag.StartX + (args.ClientX - _connectionDrag.StartClientX);
            var previewRawY = _connectionDrag.StartY + (args.ClientY - _connectionDrag.StartClientY);
            _connectionDrag.CurrentX = BlockDiagramLayout.SnapToGrid(previewRawX);
            _connectionDrag.CurrentY = BlockDiagramLayout.SnapToGrid(previewRawY);

            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_resizingBlockId is not null)
        {
            var block = TryGetBlock(_resizingBlockId);
            if (block is null)
            {
                _resizingBlockId = null;
                return;
            }

            if (args.Buttons == 0)
            {
                EndResize();
                return;
            }

            var rawWidth = _resizeStartWidth + (args.ClientX - _resizeStartClientX);
            var rawHeight = _resizeStartHeight + (args.ClientY - _resizeStartClientY);
            var snappedWidth = BlockDiagramLayout.SnapSizeToGrid(rawWidth, BlockDiagramLayout.MinimumBlockWidth);
            var snappedHeight = BlockDiagramLayout.SnapSizeToGrid(rawHeight, BlockDiagramLayout.MinimumBlockHeight);
            var widthBounds = BlockDiagramLayout.GetLaneHorizontalBounds(block.Role, _canvasWidth);
            var maxWidthInLane = Math.Max(
                BlockDiagramLayout.MinimumBlockWidth,
                BlockDiagramLayout.SnapToGrid(widthBounds.MaxX - block.X));
            snappedWidth = Math.Min(snappedWidth, maxWidthInLane);

            if (Math.Abs(snappedWidth - block.Width) < 0.001 && Math.Abs(snappedHeight - block.Height) < 0.001)
            {
                return;
            }

            block.Width = snappedWidth;
            block.Height = snappedHeight;

            await NotifyModelChangedAsync();
            return;
        }

        if (_draggingBlockId is null)
        {
            return;
        }

        var draggedBlock = TryGetBlock(_draggingBlockId);
        if (draggedBlock is null)
        {
            _draggingBlockId = null;
            return;
        }

        if (args.Buttons == 0)
        {
            EndDrag();
            return;
        }

        var blockRawX = _dragStartBlockX + (args.ClientX - _dragStartClientX);
        var blockRawY = _dragStartBlockY + (args.ClientY - _dragStartClientY);
        var bounds = BlockDiagramLayout.GetLaneHorizontalBounds(draggedBlock.Role, _canvasWidth);
        var minX = bounds.MinX;
        var maxX = Math.Max(minX, bounds.MaxX - draggedBlock.Width);
        var snappedX = BlockDiagramLayout.SnapToGrid(Math.Clamp(blockRawX, minX, maxX));
        var snappedY = BlockDiagramLayout.SnapToGrid(Math.Max(BlockDiagramLayout.MinimumBlockOffset, blockRawY));

        if (Math.Abs(snappedX - draggedBlock.X) < 0.001 && Math.Abs(snappedY - draggedBlock.Y) < 0.001)
        {
            return;
        }

        draggedBlock.X = snappedX;
        draggedBlock.Y = snappedY;

        await NotifyModelChangedAsync();
    }

    private void HandleCanvasMouseUp(MouseEventArgs _)
    {
        EndDrag();
        EndResize();

        if (_connectionDrag is not null)
        {
            CancelConnectionDrag("Connection cancelled.");
        }
    }

    private void HandleCanvasMouseLeave(MouseEventArgs _)
    {
        EndDrag();
        EndResize();

        if (_connectionDrag is not null)
        {
            CancelConnectionDrag("Connection cancelled.");
        }
    }

    private void HandleLinkClick(string linkId)
    {
        if (TryGetLink(linkId) is null)
        {
            return;
        }

        _selectedLinkId = linkId;
        _selectedBlockId = null;
        _status = "Selected connection.";
    }

    private async Task HandleLabelInputAsync(ChangeEventArgs args)
    {
        var block = SelectedBlock;
        if (block is null)
        {
            return;
        }

        var nextLabel = args.Value?.ToString() ?? string.Empty;
        if (string.Equals(block.Label, nextLabel, StringComparison.Ordinal))
        {
            return;
        }

        RecordHistoryBeforeChange();
        block.Label = nextLabel;
        _status = $"Updated label for {block.Id}.";

        await NotifyModelChangedAsync();
    }

    private void EndDrag()
    {
        if (_draggingBlockId is null)
        {
            return;
        }

        var block = TryGetBlock(_draggingBlockId);
        var startX = _dragStartBlockX;
        var startY = _dragStartBlockY;
        _draggingBlockId = null;
        _dragStartClientX = 0;
        _dragStartClientY = 0;
        _dragStartBlockX = 0;
        _dragStartBlockY = 0;

        if (block is not null)
        {
            if (_dragStartSnapshot is not null &&
                (Math.Abs(block.X - startX) >= 0.001 || Math.Abs(block.Y - startY) >= 0.001))
            {
                PushHistorySnapshot(_dragStartSnapshot);
            }

            _status = $"Placed {block.Label}.";
        }

        _dragStartSnapshot = null;
    }

    private void EndResize()
    {
        if (_resizingBlockId is null)
        {
            return;
        }

        var block = TryGetBlock(_resizingBlockId);
        var startWidth = _resizeStartWidth;
        var startHeight = _resizeStartHeight;
        _resizingBlockId = null;
        _resizeStartClientX = 0;
        _resizeStartClientY = 0;
        _resizeStartWidth = 0;
        _resizeStartHeight = 0;

        if (block is not null)
        {
            if (_resizeStartSnapshot is not null &&
                (Math.Abs(block.Width - startWidth) >= 0.001 || Math.Abs(block.Height - startHeight) >= 0.001))
            {
                PushHistorySnapshot(_resizeStartSnapshot);
            }

            _status = $"Resized {block.Label}.";
        }

        _resizeStartSnapshot = null;
    }

    private void CancelConnectionDrag(string status)
    {
        _connectionDrag = null;
        _status = status;
    }

    private DiagramHistorySnapshot CaptureHistorySnapshot()
    {
        return new DiagramHistorySnapshot(Model.Clone(), _selectedBlockId, _selectedLinkId);
    }

    private void RecordHistoryBeforeChange()
    {
        PushHistorySnapshot(CaptureHistorySnapshot());
    }

    private void PushHistorySnapshot(DiagramHistorySnapshot snapshot)
    {
        _undoStack.Push(snapshot);
        _redoStack.Clear();
    }

    private void RestoreHistorySnapshot(DiagramHistorySnapshot snapshot)
    {
        Model = snapshot.Model.Clone();
        _selectedBlockId = snapshot.SelectedBlockId;
        _selectedLinkId = snapshot.SelectedLinkId;
        _draggingBlockId = null;
        _resizingBlockId = null;
        _connectionDrag = null;
        _dragStartSnapshot = null;
        _resizeStartSnapshot = null;
        BlockDiagramLayout.ConstrainBlocksToLanes(Model, _canvasWidth);
    }

    private void ToggleInspectorPanel()
    {
        _showInspector = !_showInspector;
    }

    private async Task UpdateCanvasWidthAsync()
    {
        if (_canvasElement.Context is null)
        {
            return;
        }

        var measuredWidth = await JS.InvokeAsync<double>("blockDiagramInterop.getWidth", _canvasElement);
        if (ApplyCanvasWidth(measuredWidth))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task HandleCanvasResize(double measuredWidth)
    {
        return InvokeAsync(() =>
        {
            if (ApplyCanvasWidth(measuredWidth))
            {
                StateHasChanged();
            }
        });
    }

    private bool ApplyCanvasWidth(double measuredWidth)
    {
        var safeWidth = Math.Max(BlockDiagramLayout.MinimumCanvasWidth, measuredWidth);

        if (_hasMeasuredCanvas && Math.Abs(_canvasWidth - safeWidth) < 1)
        {
            return false;
        }

        _hasMeasuredCanvas = true;
        _canvasWidth = safeWidth;
        BlockDiagramLayout.ConstrainBlocksToLanes(Model, _canvasWidth);
        return true;
    }

    private DiagramBlock? TryGetBlock(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        return Model.Blocks.FirstOrDefault(block => block.Id == id);
    }

    private DiagramLink? TryGetLink(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        return Model.Links.FirstOrDefault(link => link.Id == id);
    }

    private string GetLaneStyle(DiagramBlockRole role)
    {
        var layout = BlockDiagramLayout.GetLaneLayout(_canvasWidth);

        return role switch
        {
            DiagramBlockRole.Input => $"left:{layout.InputStart:0.###}px; width:{BlockDiagramLayout.InputLaneWidth:0.###}px;",
            DiagramBlockRole.Function => $"left:{layout.FunctionStart:0.###}px; width:{layout.FunctionWidth:0.###}px;",
            DiagramBlockRole.Output => $"left:{layout.OutputStart:0.###}px; width:{BlockDiagramLayout.OutputLaneWidth:0.###}px;",
            _ => string.Empty
        };
    }

    private bool TryGetConnectionPreviewPath(out string pathData)
    {
        if (_connectionDrag is null)
        {
            pathData = string.Empty;
            return false;
        }

        return BlockDiagramRouter.TryGetConnectionPreviewPath(
            Model,
            _connectionDrag.SourceBlockId,
            _connectionDrag.SourceSide,
            _connectionDrag.CurrentX,
            _connectionDrag.CurrentY,
            out pathData);
    }

    private string GetLinkCssClass(DiagramLink link)
    {
        return _selectedLinkId == link.Id ? "link-line selected" : "link-line";
    }

    private string GetBlockShellStyle(DiagramBlock block)
    {
        return $"left:{block.X:0.###}px; top:{block.Y:0.###}px; width:{block.Width:0.###}px; height:{block.Height:0.###}px;";
    }

    private string GetBlockCssClass(DiagramBlock block)
    {
        var roleClass = block.Role switch
        {
            DiagramBlockRole.Input => " role-input",
            DiagramBlockRole.Function => " role-function",
            DiagramBlockRole.Output => " role-output",
            _ => string.Empty
        };

        if (_resizingBlockId == block.Id)
        {
            return $"diagram-block selected resizing{roleClass}";
        }

        return _selectedBlockId == block.Id
            ? $"diagram-block selected{roleClass}"
            : $"diagram-block{roleClass}";
    }

    private string GetConnectorCssClass(DiagramBlock block, DiagramConnectorSide side)
    {
        var classes = "connector-handle";

        if (_connectionDrag is not null &&
            _connectionDrag.SourceBlockId == block.Id &&
            _connectionDrag.SourceSide == side)
        {
            classes += " active";
        }

        return classes;
    }

    private string GetConnectorStyle(DiagramBlock block, DiagramConnectorSide side)
    {
        var halfSize = ConnectorHitTargetSize / 2;
        var x = (block.Width / 2) - halfSize;
        var y = (block.Height / 2) - halfSize;

        switch (side)
        {
            case DiagramConnectorSide.Top:
                y = -halfSize;
                break;
            case DiagramConnectorSide.Right:
                x = block.Width - halfSize;
                break;
            case DiagramConnectorSide.Bottom:
                y = block.Height - halfSize;
                break;
            case DiagramConnectorSide.Left:
                x = -halfSize;
                break;
        }

        return $"left:{x:0.###}px; top:{y:0.###}px; width:{ConnectorHitTargetSize:0.###}px; height:{ConnectorHitTargetSize:0.###}px; --connector-dot-size:{ConnectorHandleSize:0.###}px;";
    }

    private string GetResizeHandleCssClass(DiagramBlock block)
    {
        return _resizingBlockId == block.Id ? "resize-handle active" : "resize-handle";
    }

    private string GetResizeHandleStyle(DiagramBlock block)
    {
        var halfSize = ResizeHandleSize / 2;
        var x = block.Width - halfSize;
        var y = block.Height - halfSize;
        return $"left:{x:0.###}px; top:{y:0.###}px; width:{ResizeHandleSize:0.###}px; height:{ResizeHandleSize:0.###}px;";
    }

    private static string GetConnectorTitle(DiagramBlock block, DiagramConnectorSide side)
    {
        return $"{block.Label} - {side} connector";
    }

    private async Task NotifyModelChangedAsync()
    {
        if (ModelChanged.HasDelegate)
        {
            await ModelChanged.InvokeAsync(Model);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_canvasElement.Context is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("blockDiagramInterop.unobserveCanvas", _canvasElement);
                await JS.InvokeVoidAsync("blockDiagramInterop.unregisterDeleteShortcut", _canvasElement);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }

    private sealed class ConnectionDragState
    {
        public required string SourceBlockId { get; init; }
        public DiagramConnectorSide SourceSide { get; init; }
        public double StartClientX { get; init; }
        public double StartClientY { get; init; }
        public double StartX { get; init; }
        public double StartY { get; init; }
        public double CurrentX { get; set; }
        public double CurrentY { get; set; }
    }

    private sealed record DiagramHistorySnapshot(
        BlockDiagramModel Model,
        string? SelectedBlockId,
        string? SelectedLinkId);

}
