@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_elementId" class="@ClassName"></div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="text-danger mt-2">@_error</div>
}

@code {
    [Parameter] public string InitialExample { get; set; } = "sample";
    [Parameter] public string? ClassName { get; set; } = "joint-canvas";
    [Parameter] public EventCallback<string> GraphChanged { get; set; }

    private readonly string _elementId = $"joint_{Guid.NewGuid():N}";
    private bool _initialized;
    private string? _error;
    private DotNetObjectReference<JointJsCanvas>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await InitializeAsync();
    }

    public async Task InitializeAsync()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("jointInterop.initialize", _elementId, InitialExample, _dotNetRef);
            _initialized = true;
            _error = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task LoadExampleAsync(string exampleKey)
    {
        if (!_initialized)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("jointInterop.loadExample", _elementId, exampleKey);
            _error = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task<string> AddBlockAsync(string label)
    {
        return await AddRoleBlockAsync("action", label);
    }

    public async Task<string> AddRoleBlockAsync(string role, string label)
    {
        if (!_initialized)
        {
            return string.Empty;
        }

        try
        {
            return await JS.InvokeAsync<string>("jointInterop.addRoleBlock", _elementId, role, label);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
            return string.Empty;
        }
    }

    public async Task<string> BeginConnectModeAsync()
    {
        if (!_initialized)
        {
            return string.Empty;
        }

        try
        {
            return await JS.InvokeAsync<string>("jointInterop.beginConnectMode", _elementId);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
            return string.Empty;
        }
    }

    public async Task<string> CancelModeAsync()
    {
        if (!_initialized)
        {
            return string.Empty;
        }

        try
        {
            return await JS.InvokeAsync<string>("jointInterop.cancelMode", _elementId);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
            return string.Empty;
        }
    }

    public async Task<bool> DeleteSelectedAsync()
    {
        if (!_initialized)
        {
            return false;
        }

        try
        {
            return await JS.InvokeAsync<bool>("jointInterop.deleteSelected", _elementId);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
            return false;
        }
    }

    public async Task<bool> RenameSelectedAsync(string? newLabel)
    {
        if (!_initialized)
        {
            return false;
        }

        try
        {
            return await JS.InvokeAsync<bool>("jointInterop.renameSelected", _elementId, newLabel);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
            return false;
        }
    }

    public async Task<string> GetJsonAsync()
    {
        if (!_initialized)
        {
            return string.Empty;
        }

        try
        {
            return await JS.InvokeAsync<string>("jointInterop.getJson", _elementId);
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
            return string.Empty;
        }
    }

    [JSInvokable]
    public async Task OnGraphChanged(string json)
    {
        await GraphChanged.InvokeAsync(json);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_initialized)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("jointInterop.dispose", _elementId);
        }
        catch (JSException)
        {
            // Ignore teardown errors during app shutdown.
        }

        _dotNetRef?.Dispose();
    }
}
